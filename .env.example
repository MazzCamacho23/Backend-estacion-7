# Copia este archivo como .env y ajusta los valores.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL. Con Neon, `neon env pull` / `neon deploy` las escribe solas:
#   DATABASE_URL          -> host con "-pooler" (la usa la API)
#   DATABASE_URL_UNPOOLED -> host directo (la usan las migraciones)
# En local sin pooler, ambas pueden ser la misma URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estacion_siete?schema=public
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/estacion_siete?schema=public

# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Orígenes permitidos (coma separada). Las apps Android nativas no envían Origin, así que "*" es seguro para ellas.
CORS_ORIGINS=*

BUSINESS_TIMEZONE=America/Bogota

# true  = una venta nunca se bloquea por inventario (el stock puede quedar negativo y se alerta).
# false = la venta se rechaza si un insumo no alcanza.
ALLOW_NEGATIVE_STOCK=true

# Solo para `npm run db:seed`
SEED_DEFAULT_PASSWORD=Cambiar123*
